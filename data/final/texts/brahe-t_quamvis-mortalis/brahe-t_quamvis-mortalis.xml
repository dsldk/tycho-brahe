      <front/>
      <body>
         <div xml:id="text">
            <head>
               <orig/>
               <reg>Quamvis mortalis</reg>
               <reg xml:lang="en">Quamvis mortalis</reg>
            </head>
            <lg>
               <l>
                  <pb ed="TBOO" n="IX.215"/>QVAMVIS <app>
                     <lem>mortalis</lem>
                     <rdg>corr. ex <q>Humanus</q> in A</rdg>
                  </app> vescor mortalibus auris </l>
               <l rend="indent">Et <app>
                     <lem>quoque mortali</lem>
                     <rdg>corr. ex <q>mortali etiam</q> in A</rdg>
                  </app> conditione premor, </l>
               <app>
                  <lem>
                     <l>Cum tamen Astrorum sublimi mente meatus</l>
                     <l rend="indent">Scrutor et Ætherei Mystica fata poli.</l>
                     <l>Haud ego mortalis neque mens in corpore sorde</l>
                     <l rend="indent">Mortali aut terræ pes mihi tangit humum,</l>
                     <l>Sed sublime polo caput vltra nubila tollo</l>
                     <l rend="indent">Ambrosiaque Deûm cum Ioue rege fruor.</l>
                  </lem>
                  <rdg>corr. ex <q>Attamen æternos quos seruant Sydera motus / Cum uoluo et meditor
                  Mystica fata poli, / Non terræ insisto ast caput inter nubila condens / Ambrosia
                  in cœlo cum Ioue sæpe fruor</q> in A</rdg>
               </app>
            </lg>
         </div>
      </body>
