         <div xml:id="text">
            <head>
               <orig/>
               <reg>Iudicis est æqui</reg>
               <reg xml:lang="en">Iudicis est æqui</reg>
            </head>
            <lg>
               <l>
                  <pb ed="TBOO" n="IX.192"/>IUDICIS est æqui verum rectumque tueri, </l>
               <l rend="indent">Non obstare bonis nilque iuvare malos. </l>
               <l>Tu tamen impulsum (testis Deus) æqua movere</l>
               <l rend="indent">Negligis et nequam fersque fovesque malum. </l>
               <l n="5">Ast cito, crede mihi, vindex fandi atque nefandi</l>
               <l rend="indent">Efficiet, pœnas causa proterva luat. </l>
               <l>Si sapis ergo, tuæ bene consule, Lago, saluti, </l>
               <l rend="indent">Et mihi si non vis parcere, parce tibi.</l>
            </lg>
            <closer>
               <signed>
                  <persName key="brahe_tycho_1546">T. B.</persName>
               </signed>
               <dateline>Anno 1592, die 15 Febr. in itinere a Ringstadio domum.</dateline>
            </closer>
         </div>
