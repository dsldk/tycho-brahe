      <body>
         <div xml:id="text">
            <head>
               <orig>
                  <pb ed="TBOO" n="IX.175"/>
                  <pb ed="A" n="1"/>FUNDAMENTALI URANIBURGI LAPIDI HÆC FUERE INSCULPTA.</orig>
               <reg>Fundamentalis Uraniburgi lapis</reg>
            </head>
            <lg>
               <l>TEMPORE quo regnum qui nomine reque secundus</l>
               <l rend="indent">Danorum imperio rex Fridericus habet,</l>
               <l>
                  <app>
                     <lem wit="TBOO">Carolus</lem>
                     <rdg wit="Gass Resen"/>
                  </app> ad Danos Galli legatio regis</l>
               <l rend="indent">
                  <app>
                     <lem wit="Gass">Danzæus, patria cui est Aquitane solum</lem>
                     <rdg wit="Resen">Danzæus, quem orbis terra Aquitata tulit</rdg>
                  </app>,</l>
               <l n="5">Huic domui, Uraniæ et Sophiæ quam Tycho Brahorum</l>
               <l rend="indent">Clara stirpe satus, rege jubente, struit,</l>
               <l>Hunc lapidem auspicio felici, utque omne per ævum</l>
               <l rend="indent">Augusti id memoret lux modo sexta, locat.</l>
            </lg>
            <p/>
         </div>
      </body>
